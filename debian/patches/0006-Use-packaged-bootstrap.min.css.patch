From: Fukui Daichi <a.dog.will.talk@akane.waseda.jp>
Last-Update: 2026-11-14
Subject: Use packaged bootstrap.min.css
 Load bootstrap.min.css from libjs-bootstrap5 (src:bootstrap-html)
 instead of the CDN. The integrity and crossorigin attributes are dropped
 because the SRI hash only matches the upstream CDN file.
Bug-Debian: https://bugs.debian.org/1088499
Forwarded: not-needed

---
 pytest_mpl/summary/templates/base.html | 2 +-
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/pytest_mpl/summary/templates/base.html b/pytest_mpl/summary/templates/base.html
index 4ac3c66..243384d 100644
--- a/pytest_mpl/summary/templates/base.html
+++ b/pytest_mpl/summary/templates/base.html
@@ -4,8 +4,7 @@
     <meta charset="utf-8">
     <meta name="viewport" content="width=device-width, initial-scale=1">
     <link href="styles.css" rel="stylesheet">
-    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet"
-          integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
+    <link href="/usr/share/javascript/bootstrap5/css/bootstrap.min.css" rel="stylesheet">
     <title>{{ results.title }}</title>
 </head>
 <body id="results">
